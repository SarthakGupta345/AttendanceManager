      "source": [
        "\n",
        "# ============================================================\n",
        "# COMPUTER NETWORKS LAB\n",
        "# Chandan Gupta\n",
        "# 24112011169\n",
        "# Experiment: Implementation of TCP/IP Echo\n",
        "# ============================================================\n",
        "\n",
        "\n",
        "import socket\n",
        "import threading\n",
        "import time\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# PART 1: TCP ECHO SERVER\n",
        "# ============================================================\n",
        "\n",
        "def echo_server():\n",
        "\n",
        "    print(\"\\n================================================\")\n",
        "    print(\"                 TCP ECHO SERVER\")\n",
        "    print(\"================================================\")\n",
        "\n",
        "    # Create TCP socket\n",
        "    server_socket = socket.socket(\n",
        "        socket.AF_INET,\n",
        "        socket.SOCK_STREAM\n",
        "    )\n",
        "\n",
        "    # Allow reuse of the port\n",
        "    server_socket.setsockopt(\n",
        "        socket.SOL_SOCKET,\n",
        "        socket.SO_REUSEADDR,\n",
        "        1\n",
        "    )\n",
        "\n",
        "    # Server IP address and port\n",
        "    host = \"127.0.0.1\"\n",
        "    port = 12345\n",
        "\n",
        "    # Bind socket to address\n",
        "    server_socket.bind((host, port))\n",
        "\n",
        "    # Listen for client connections\n",
        "    server_socket.listen(1)\n",
        "\n",
        "    print(\"Server started successfully.\")\n",
        "    print(\"Waiting for client connection...\")\n",
        "\n",
        "    # Accept client connection\n",
        "    connection, address = server_socket.accept()\n",
        "\n",
        "    print(\"Client connected:\", address)\n",
        "\n",
        "    with connection:\n",
        "\n",
        "        while True:\n",
        "\n",
        "            # Receive message from client\n",
        "            data = connection.recv(1024)\n",
        "\n",
        "            # Stop if no data is received\n",
        "            if not data:\n",
        "                break\n",
        "\n",
        "            message = data.decode()\n",
        "\n",
        "            print(\"\\nMessage received from client:\", message)\n",
        "\n",
        "            # Send the same message back\n",
        "            connection.sendall(data)\n",
        "\n",
        "            print(\"Echo sent successfully.\")\n",
        "\n",
        "    print(\"\\nClient disconnected.\")\n",
        "\n",
        "    # Close server socket\n",
        "    server_socket.close()\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# PART 2: TCP ECHO CLIENT\n",
        "# ============================================================\n",
        "\n",
        "def echo_client():\n",
        "\n",
        "    # Wait for server to start\n",
        "    time.sleep(1)\n",
        "\n",
        "    print(\"\\n================================================\")\n",
        "    print(\"                 TCP ECHO CLIENT\")\n",
        "    print(\"================================================\")\n",
        "\n",
        "    # Create TCP socket\n",
        "    client_socket = socket.socket(\n",
        "        socket.AF_INET,\n",
        "        socket.SOCK_STREAM\n",
        "    )\n",
        "\n",
        "    # Server address and port\n",
        "    host = \"127.0.0.1\"\n",
        "    port = 12345\n",
        "\n",
        "    # Connect to server\n",
        "    client_socket.connect((host, port))\n",
        "\n",
        "    print(\"Connected to TCP Echo Server.\")\n",
        "\n",
        "    # Messages to send\n",
        "    messages = [\n",
        "        \"Hello Server!\",\n",
        "        \"Computer Networks Lab\",\n",
        "        \"TCP/IP Echo Implementation\"\n",
        "    ]\n",
        "\n",
        "    # Send and receive messages\n",
        "    for message in messages:\n",
        "\n",
        "        print(\"\\nSending message:\", message)\n",
        "\n",
        "        # Send message to server\n",
        "        client_socket.sendall(message.encode())\n",
        "\n",
        "        # Receive echoed response\n",
        "        response = client_socket.recv(1024)\n",
        "\n",
        "        print(\n",
        "            \"Message received from server:\",\n",
        "            response.decode()\n",
        "        )\n",
        "\n",
        "    # Close client connection\n",
        "    client_socket.close()\n",
        "\n",
        "    print(\"\\nClient socket closed.\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# PART 3: MAIN PROGRAM\n",
        "# ============================================================\n",
        "\n",
        "print(\"======================================================\")\n",
        "print(\"          TCP/IP ECHO IMPLEMENTATION\")\n",
        "print(\"              COMPUTER NETWORKS LAB\")\n",
        "print(\"======================================================\")\n",
        "\n",
        "\n",
        "# Create server and client threads\n",
        "server_thread = threading.Thread(\n",
        "    target=echo_server\n",
        ")\n",
        "\n",
        "client_thread = threading.Thread(\n",
        "    target=echo_client\n",
        ")\n",
        "\n",
        "\n",
        "# Start server and client\n",
        "server_thread.start()\n",
        "client_thread.start()\n",
        "\n",
        "\n",
        "# Wait for both threads to finish\n",
        "server_thread.join()\n",
        "client_thread.join()\n",
        "\n",
        "\n",
        "print(\"\\n======================================================\")\n",
        "print(\"                 PROGRAM COMPLETED\")\n",
        "print(\"======================================================\")"
      ]
    }
  ]
}